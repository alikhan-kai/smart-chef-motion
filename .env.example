OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=60
TWO_STEP_MODE=false

# Per-attempt cost estimate used only for structured usage logs. These example
# rates are GPT-6 Luna standard short-context prices checked on 2026-09-30;
# update all fields when OPENAI_MODEL changes. The billing dashboard is authoritative.
OPENAI_PRICING_MODEL=gpt-6-luna
OPENAI_INPUT_COST_PER_MILLION_USD=0.10
OPENAI_CACHED_INPUT_COST_PER_MILLION_USD=0.01
OPENAI_CACHE_WRITE_COST_PER_MILLION_USD=0.125
OPENAI_OUTPUT_COST_PER_MILLION_USD=0.50
OPENAI_WEB_SEARCH_COST_PER_CALL_USD=0.01

# Optional: enables Supabase-backed persistence for the recipe book and
# recipe magazine feature. Leave unset for local dev / tests, which then
# fall back to in-memory repositories (see backend/main.py).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: validates that Alice webhook requests name your actual skill.
# Copy the id from the Yandex Dialogs skill overview after creating the skill.
YANDEX_ALICE_SKILL_ID=
