OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_SECONDS=60
TWO_STEP_MODE=false

# Optional: enables Supabase-backed persistence for the recipe book and
# recipe magazine feature. Leave unset for local dev / tests, which then
# fall back to in-memory repositories (see backend/main.py).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
